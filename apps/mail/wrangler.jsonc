{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeromail",
  "compatibility_date": "2025-06-27",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./build/client/",
    "not_found_handling": "single-page-application",
    "html_handling": "force-trailing-slash",
  },
  "env": {
    "local": {
      "name": "zeromail-local",
      "vars": {
        "VITE_PUBLIC_BACKEND_URL": "http://localhost:8787",
        "VITE_PUBLIC_APP_URL": "http://localhost:3000",
      },
    },
    "staging": {
      "name": "zeromail-staging",
      "vars": {
        "VITE_PUBLIC_BACKEND_URL": "https://0mail-server.sacra.my",
        "VITE_PUBLIC_APP_URL": "https://0mail.sacra.my",
      },
    },
    "production": {
      "name": "zeromail-production",
      "vars": {
        "VITE_PUBLIC_BACKEND_URL": "https://api.0.email",
        "VITE_PUBLIC_APP_URL": "https://0.email",
      },
    },
  },
}
